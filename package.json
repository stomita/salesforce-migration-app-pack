    "npm-run-all": "^4.1.5",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "recoil": "^0.4.0",
    "salesforce-migration-automatic": "^4.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.8",
